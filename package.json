{
  "name": "oru",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Oru — desktop digital twin that orchestrates Claude Code on your local projects",
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:native": "node scripts/buildNative.mjs",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "smoke:all": "tsx scripts/smokeRunner.ts",
    "smoke:one": "tsx scripts/smokeRunner.ts",
    "smoke:render": "electron tests/smoke/electron/bootstrap.mjs",
    "smoke:image": "electron tests/smoke/electron/imageThumbSmokeBootstrap.mjs",
    "smoke:contactsheet": "electron tests/smoke/electron/contactSheetBootstrap.mjs",
    "smoke:deckvalidate": "electron tests/smoke/electron/deckValidateBootstrap.mjs",
    "smoke:chat": "tsx --tsconfig tsconfig.node.json tests/smoke/__smoke_chat__.ts",
    "smoke:e2e": "tsx --tsconfig tsconfig.node.json tests/smoke/__smoke_e2e__.ts",
    "smoke:asktwin": "tsx --tsconfig tsconfig.node.json tests/smoke/__smoke_asktwin__.ts",
    "smoke:dream": "NODE_OPTIONS='--import ./tests/smoke/_electronStub/register.mjs' tsx --tsconfig tsconfig.node.json tests/smoke/__smoke_dream__.ts",
    "smoke:capture": "NODE_OPTIONS='--import ./tests/smoke/_electronStub/register.mjs' tsx --tsconfig tsconfig.node.json tests/smoke/__smoke_capture__.ts",
    "smoke:memory-scale": "NODE_OPTIONS='--import ./tests/smoke/_electronStub/register.mjs' tsx --tsconfig tsconfig.node.json tests/smoke/__smoke_memory_scale__.ts",
    "smoke:memory-chain": "NODE_OPTIONS='--import ./tests/smoke/_electronStub/register.mjs' tsx --tsconfig tsconfig.node.json tests/smoke/__smoke_memory_chain__.ts",
    "smoke:rollback": "tsx --tsconfig tsconfig.node.json tests/smoke/__smoke_rollback__.ts",
    "smoke:queue": "tsx --tsconfig tsconfig.node.json tests/smoke/__smoke_queue__.ts",
    "smoke:escalate": "tsx --tsconfig tsconfig.node.json tests/smoke/__smoke_escalate__.ts",
    "smoke:devstart": "tsx --tsconfig tsconfig.node.json tests/smoke/__smoke_devstart__.ts",
    "smoke:taskboard": "tsx --tsconfig tsconfig.node.json tests/smoke/__smoke_taskboard__.ts",
    "smoke:taskboard:comments-basic": "tsx --tsconfig tsconfig.node.json tests/smoke/__smoke_taskboard_comments_basic__.ts",
    "smoke:taskboard:busy": "tsx --tsconfig tsconfig.node.json tests/smoke/__smoke_taskboard_busy__.ts",
    "smoke:subagent-chat": "tsx --tsconfig tsconfig.node.json tests/smoke/__smoke_subagent_chat__.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:conventions": "bash scripts/lintConventions.sh",
    "test:all": "npm run lint:conventions && npm run typecheck && npm run test && npm run smoke:all"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.0",
    "@anthropic-ai/sdk": "^0.92.0",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/merge": "^6.12.1",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.34.0",
    "@larksuiteoapi/node-sdk": "^1.67.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tanstack/react-virtual": "^3.14.2",
    "@types/proper-lockfile": "^4.1.4",
    "@uiw/react-codemirror": "^4.23.7",
    "active-win": "^8.2.1",
    "discord.js": "^14.26.4",
    "exceljs": "^4.4.0",
    "framer-motion": "^11.15.0",
    "gray-matter": "^4.0.3",
    "i18next": "^26.3.2",
    "iconv-lite": "^0.7.2",
    "ignore": "^6.0.2",
    "jszip": "^3.10.1",
    "katex": "^0.17.0",
    "lucide-react": "^0.468.0",
    "nanoid": "^5.0.9",
    "papaparse": "^5.5.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "pptxgenjs": "^4.0.1",
    "proper-lockfile": "^4.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.8",
    "react-markdown": "^9.0.1",
    "rehype-highlight": "^7.0.1",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "simple-git": "^3.27.0",
    "turndown": "^7.2.4",
    "uiohook-napi": "^1.5.5",
    "ws": "^8.18.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/diff": "^7.0.2",
    "@types/node": "^22.10.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "diff": "^5.2.2",
    "electron": "^41.3.0",
    "electron-vite": "^2.3.0",
    "jsdom": "^29.0.2",
    "node-addon-api": "^8.3.0",
    "node-gyp": "^11.0.0",
    "postcss": "^8.4.49",
    "tailwind-merge": "^2.5.5",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "undici": "^6.27.0",
    "vite": "^5.4.11",
    "vitest": "^4.1.5"
  },
  "build": {
    "appId": "com.oru.app",
    "productName": "Oru",
    "files": [
      "out/**/*"
    ],
    "mac": {
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "extraResources": [
      {
        "from": "resources/builtin-skills",
        "to": "builtin-skills",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/self-knowledge",
        "to": "self-knowledge",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "electron/native/desktop/build/Release/desktop_native.node",
        "to": "desktop_native.node"
      }
    ]
  }
}
